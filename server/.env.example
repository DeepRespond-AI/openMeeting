# 深应会议服务端：开发 / 生产共用配置模板
# 覆盖 docker-compose.yml 读取的全部配置变量；不包含真实密码、密钥或个人服务器地址。
# “默认”指 Compose / 程序的默认行为；已填写的占位值和本机示例需要按环境替换。
# 可分别复制为 .env.dev、.env.prod，已有实际配置不要覆盖；这两个文件均不提交 Git。
# 在 server/ 中用 --env-file 显式选择文件，当前终端的同名变量会优先于文件。
# 开发：docker compose --env-file .env.dev -f docker-compose.yml -f docker-compose.dev.yml up -d --build
# 生产：docker compose --env-file .env.prod -f docker-compose.yml up -d --build
# 不传 --env-file 时使用 .env；仅修改此模板不会改变运行中的服务。
# 详细说明：README.md、docker_dev.md、../docs/object-storage.md、../docs/unified-egress.md。

# ---- 1. 环境与必填凭据 ----
# 默认按生产模式处理。开发可设 dev；dev / development / test 会启用开发模式。
# 开发模式仅在短信未配置时返回 dev_code；生产必须使用 production，不依赖开发验证码。
OPENMEETING_ENV=production
# 管理端密码：Compose 必填，无可用的生产默认值；开发 / 生产分别设置，不使用此占位值。
OPENMEETING_ADMIN_PASSWORD=replace-with-admin-password
# 服务间共享令牌：Compose 必填；自动传为各服务的 OPENMEETING_INTERNAL_SERVICE_TOKEN。
# 各服务使用同一长随机值；开发 / 生产分别生成，不复用管理员密码或下面的密钥。
INTERNAL_SERVICE_TOKEN=replace-with-a-long-random-internal-token
# JWT、上传票据和数据库内供应商凭据的加密密钥：各服务必须一致，生产必须显式配置。
# 使用独立、持久的长随机值；妥善备份，更换会影响已有会话、票据及已加密的凭据。
OPENMEETING_SECRET_KEY=replace-with-a-persistent-shared-random-secret

# ---- 2. 三个独立 PostgreSQL 数据库 ----
# 默认回退密码 openmeeting；仅供本机开发示例。生产为三个数据库分别填写独立强密码。
# 专用密码非空时优先；专用密码未设置或为空时回退 POSTGRES_PASSWORD，再回退 openmeeting。
# 密码同时写入数据库容器和连接 URL，建议使用足够长的 URL 安全随机串，避免特殊字符歧义。
# 已有数据库不会因修改这里的值自动修改角色密码；轮换时须同步修改数据库角色。
POSTGRES_PASSWORD=openmeeting
USER_POSTGRES_PASSWORD=openmeeting
MEETING_POSTGRES_PASSWORD=openmeeting
STT_POSTGRES_PASSWORD=openmeeting

# ---- 3. 网关、日志与可信代理 ----
# 宿主机业务入口端口，默认 39110；容器内网关仍监听 39110。
# OPENMEETING_PORT=39110
# 日志级别，默认 INFO；开发排查可改 DEBUG，生产通常保留 INFO。
# OPENMEETING_LOG_LEVEL=INFO
# 业务 HTTP CORS 来源，逗号分隔，默认空；原生客户端不需要为此开启 CORS。
# 浏览器开发填实际开发页面源，生产仅填实际业务网页源；对象存储直传的 CORS 在 Bucket 单独设置。
# OPENMEETING_CORS_ORIGINS=
# 可信反向代理 IP / CIDR，逗号分隔；生产按实际代理链填写，不使用通配符 *。
# 未设置或为空时：gateway_ms 为空，user_ms / meeting_ms 使用 Docker 网段 172.16.0.0/12。
# user_ms 同时将该值用于 Uvicorn 的 FORWARDED_ALLOW_IPS，以正确生成 HTTPS 更新链接。
# OPENMEETING_TRUSTED_PROXIES=

# ---- 4. 服务端 HTTP / HTTPS / WSS 出站 ----
# 业务服务经 gateway_ms:39111 认证代理出站；此端口不发布到宿主机。
# 默认域名白名单为空；下方为 MinIO 与模型仓库示例，须追加实际 IM / 短信 / OSS / LLM / ASR 域名。
# 域名规则支持精确主机和 *.suffix（不包含根域名）；重定向后的 CDN / 镜像域名也需允许。
# 开发和生产均按实际需要配置，不固定供应商 IP，不使用 extra_hosts 绕过 DNS。
OPENMEETING_EGRESS_ALLOWED_HOSTS='["minio","modelscope.cn","*.modelscope.cn","huggingface.co","*.hf.co"]'
# 默认端口 [80,443]；示例增加内部 MinIO 的 9000，不使用 MinIO 时可移除。
OPENMEETING_EGRESS_ALLOWED_PORTS='[80,443,9000]'
# 默认 []，私有地址拒绝访问；内部 MinIO / LLM 主机还须在此精确列出，并命中域名及端口白名单。
# 本机 Fake-IP 例外仅按实际请求精确添加；生产不照搬开发代理的例外清单。
OPENMEETING_EGRESS_PRIVATE_HOSTS='["minio"]'

# ---- 5. 存储后端与 Docker MinIO ----
# 程序默认 auto：OSS 配置完整则使用 OSS，否则本地卷；local 强制本地，minio / oss 显式选择后端。
# 模板选择 minio 便于开发会议录音；会中 PCM 分片必须使用 MinIO / OSS，local 不支持该分片存储。
# 生产可继续使用持久化 MinIO，或改为 oss 并补齐下一节；显式后端缺少配置时返回错误，不静默回退。
OPENMEETING_STORAGE_PROVIDER=minio
# 默认无 profile；minio 启动 MinIO 与私有 Bucket 初始化任务。
# 不使用 MinIO 时留空；已有 MinIO 文件仍被引用时，保留该 profile、配置及卷，直至完成数据迁移。
COMPOSE_PROFILES=minio
# 服务端经网关访问的内部地址，Compose 默认 http://minio:9000；不替换成客户端的公网地址。
OPENMEETING_MINIO_ENDPOINT=http://minio:9000
# 客户端直传与签名下载地址，默认 http://localhost:39120；适合同机或配置了 ADB 端口映射的开发环境。
# Android 使用此默认值时须额外执行 adb reverse tcp:39120 tcp:39120，仅映射网关 39110 不够。
# 局域网联调使用设备可达的测试地址；生产填写实际 HTTPS 存储入口，不能在签名后替换域名。
OPENMEETING_MINIO_PUBLIC_ENDPOINT=http://localhost:39120
# 区域默认 us-east-1，Bucket 默认 openmeeting；minio-init 负责创建私有 Bucket。
OPENMEETING_MINIO_REGION=us-east-1
OPENMEETING_MINIO_BUCKET=openmeeting
# MinIO 账号默认 openmeeting；密码是示例占位，开发 / 生产均自行替换，生产使用独立强密码。
OPENMEETING_MINIO_ACCESS_KEY_ID=openmeeting
OPENMEETING_MINIO_ACCESS_KEY_SECRET=replace-with-minio-password
# 对象键前缀，默认 openmeeting；改变前缀不自动迁移已有对象。
OPENMEETING_MINIO_PREFIX=openmeeting
# 宿主机 S3 API 端口默认 39120，客户端公网入口需与实际映射 / 反代一致。
# OPENMEETING_MINIO_API_PORT=39120
# 控制台端口默认 39121，仅绑定宿主机 127.0.0.1。
# OPENMEETING_MINIO_CONSOLE_PORT=39121

# ---- 6. 阿里云 OSS ----
# 默认空，使用管理端保存的 OSS 配置；非空环境变量覆盖对应后台配置。
# 选择 oss 后端时，须填写 Endpoint / Bucket / AccessKey，Region 与 Bucket 区域对应。
# 开发可使用独立测试 Bucket / 前缀；生产使用正式 Bucket 与独立凭据，避免混用测试对象。
# Endpoint 示例 oss-cn-hangzhou.aliyuncs.com，不带 Bucket、协议或对象路径。
# OPENMEETING_OSS_ENDPOINT=
# Region 默认空，优先使用后台值，也可从标准 OSS Endpoint 推断；示例 cn-hangzhou。
# OPENMEETING_OSS_REGION=
# 实际 Bucket 名；将 Bucket 域名加入上方出站白名单。
# OPENMEETING_OSS_BUCKET=
# OSS AccessKey，仅在实际环境文件或管理端填写，不将真实值放进模板。
# OPENMEETING_OSS_ACCESS_KEY_ID=
# OPENMEETING_OSS_ACCESS_KEY_SECRET=
# 对象键前缀默认空（Bucket 根目录）；示例 openmeeting，可按环境隔离对象。
# OPENMEETING_OSS_PREFIX=openmeeting
# 安装包直传 / 下载的 HTTPS 自定义域名，默认空；示例 https://download.example.com。
# APK 公网下载需绑定 OSS CNAME 和证书；该域名由 user_ms 使用，服务端读写和会议录音仍用 OSS Endpoint。
# OPENMEETING_OSS_DOWNLOAD_DOMAIN=
# 浏览器直传另需配置 Bucket PUT CORS，临时对象前缀需配置过期清理，见 ../docs/object-storage.md。

# ---- 7. 阿里云短信（user_ms） ----
# 下列默认空，使用管理端保存值；非空变量覆盖对应后台配置。
# 本机开发未配短信且 OPENMEETING_ENV=dev / test 时才使用开发验证码；生产需真实短信服务。
# 短信平台域名也须加入出站白名单；测试与生产分别使用获授权的配置。
# OPENMEETING_SMS_ACCESS_KEY_ID=
# OPENMEETING_SMS_ACCESS_KEY_SECRET=
# 短信签名与模板编号，使用供应商审核通过的值。
# OPENMEETING_SMS_SIGN_NAME=
# OPENMEETING_SMS_TEMPLATE_CODE=
# 验证码模板参数名，未在后台配置时使用 code。
# OPENMEETING_SMS_TEMPLATE_PARAM=code
# API Endpoint，未在后台配置时使用 dysmsapi.aliyuncs.com。
# OPENMEETING_SMS_ENDPOINT=dysmsapi.aliyuncs.com

# ---- 8. DeepRespond IM / RTC（user_ms） ----
# 默认 false；开发可连接测试应用，生产填写正式应用信息并设为 true。
# IM / RTC 所需的应用和服务端凭据按控制台填写，平台域名须加入出站白名单。
# OPENMEETING_IM_ENABLED=false
# 平台地址，默认空；示例 https://im.example.com。
# OPENMEETING_IM_BASE_URL=
# 应用 org / app，默认空，对应 AppKey 的 # 前后两段。
# OPENMEETING_IM_ORG_NAME=
# OPENMEETING_IM_APP_NAME=
# 服务端认证凭据，默认空，不填写客户端永久密钥。
# OPENMEETING_IM_CLIENT_ID=
# OPENMEETING_IM_CLIENT_SECRET=
# SDK 请求超时秒数，默认 10。
# OPENMEETING_IM_TIMEOUT_SECONDS=10
# 外部 IM 回调入口为 https://<业务网关域名>/im/callback。
# 回调 endpoint_id / secret 属于 user_ms 的额外参数，基础 Compose 未映射；自定义部署须显式传入。

# ---- 9. 会议、转写与模型下载 ----
# 导入 / 重转写任务并发，默认 1；开发通常不改，生产按 CPU、内存和下游容量调整。
# OPENMEETING_JOB_WORKERS=1
# 语音识别同时推理数，默认 1；生产仅在 GPU / 内存容量足够时提高。
# OPENMEETING_STT_CONCURRENCY=1
# 成功完成录音、转写和总结后，PCM 源分片保留天数，默认 3；0 表示下一轮维护可清理。
# 失败、取消或仍在处理的任务不按该期限删除源分片。
# OPENMEETING_RECORDING_CHUNK_RETENTION_DAYS=3
# 分片维护间隔秒数，默认 60，最小 10。
# OPENMEETING_RECORDING_CHUNK_MAINTENANCE_INTERVAL_SECONDS=60
# STUN / TURN 的 JSON 数组，默认 []；开发空数组仅适合可直连网络，公网部署按实际配置。
# TURN 凭据只在实际环境填写；例如 [{"urls":"stun:stun.example.com:3478"}]。
# OPENMEETING_SCREEN_SHARE_ICE_SERVERS='[]'
# Hugging Face 下载入口，默认空并使用 SDK 官方仓库；可填写获授权的 HTTPS 镜像。
# 使用镜像时，把镜像及其实际重定向 / CDN 域名加入出站白名单。
# HF_ENDPOINT=
# LLM 和云 ASR 的模型、API Key 等在管理端配置；本模板不保存供应商真实凭据。

# ---- 10. 镜像构建阶段 ----
# Debian 软件包源，默认 https://deb.debian.org；开发 / 生产均可按构建网络切换 HTTPS 镜像。
# 例如 https://mirrors.ustc.edu.cn；APT 仍校验 Debian 仓库签名。
# 仅在 build 时使用；修改后须重新构建，不是运行中容器的下载开关。
# OPENMEETING_DEBIAN_MIRROR=https://deb.debian.org

# ---- 配置生效范围 ----
# Compose 只把 environment 中声明的变量传进容器，不会把这个文件的所有键自动传入。
# 数据库 URL、容器内服务地址、OPENMEETING_DATA_DIR 和 OPENMEETING_EGRESS_PROXY_URL 已由基础编排固定。
# 裸机或单服务的额外参数及默认值见各服务 config.py / .env.example；不要当作本模板的 Compose 开关。
# 运行时配置修改后按同一编排组合执行 up -d 重新创建受影响服务；restart 不重新读取 env 文件。
# 数据卷和供应商凭据需保留，更新配置不需要执行 down -v。

# ---- Local speech-engine dependencies (image build setting) ----
# stt-cloud: lightweight cloud ASR; stt-cpu: pinned local CPU models and cloud ASR.
# Changing this requires rebuilding stt_ms. CUDA uses docker-compose.gpu.yml instead.
OPENMEETING_STT_RUNTIME=stt-cpu

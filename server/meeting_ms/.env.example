# meeting_ms（会议域服务，端口 39107）
# 数据库（docker-compose 会自动拼出地址，仅裸机部署需要设置）
# OPENMEETING_DATABASE_URL=postgresql+asyncpg://openmeeting:openmeeting@localhost:5432/openmeeting_meeting
OPENMEETING_DATA_DIR=./data
# OPENMEETING_JOB_WORKERS=1            # 导入/重转写后台任务并发数
# OPENMEETING_LOG_LEVEL=INFO
# OPENMEETING_CORS_ORIGINS=
# 加密密钥（加密 LLM / OSS 的 API Key；与其他 ms 共用同一值以保持数据可迁移）
OPENMEETING_SECRET_KEY=
# 内部服务令牌（必须与网关一致；留空时本服务接受未认证请求，仅限本地开发）
OPENMEETING_INTERNAL_SERVICE_TOKEN=
# 协作服务地址
OPENMEETING_GATEWAY_MS_URL=http://localhost:39110
# LLM / OSS 出站代理；内部令牌必须与 gateway 一致。
OPENMEETING_EGRESS_PROXY_URL=http://localhost:39111
# 屏幕共享 STUN/TURN（JSON 数组；空数组仅保证可直连网络，公网须配置 TURN）
OPENMEETING_SCREEN_SHARE_ICE_SERVERS=[]
# 业务会议连接活性；与 SDK 频道媒体心跳独立。客户端每 15 秒发送 ping。
# OPENMEETING_ROOM_HEARTBEAT_TIMEOUT_SECONDS=45
# OPENMEETING_ROOM_MEMBER_GRACE_SECONDS=90
# OPENMEETING_ROOM_HOST_GRACE_SECONDS=180
# OPENMEETING_ROOM_DISCONNECT_GRACE_SECONDS=3
# OPENMEETING_ROOM_SWEEP_INTERVAL_SECONDS=1
# ---- 阿里云 OSS（会议录音存储，可选；覆盖管理端保存的配置） ----
# OPENMEETING_OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
# OPENMEETING_OSS_REGION=
# OPENMEETING_OSS_BUCKET=
# OPENMEETING_OSS_ACCESS_KEY_ID=
# OPENMEETING_OSS_ACCESS_KEY_SECRET=
# OPENMEETING_OSS_PREFIX=openmeeting

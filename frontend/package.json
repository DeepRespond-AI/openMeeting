{
    "name": "openmeeting",
    "version": "0.1.1",
    "private": true,
    "main": "electron/main.js",
    "scripts": {
        "dev": "pnpm build:im-engine && next dev -p 3118",
        "dev:multi": "node dev-multi.mjs start",
        "dev:multi:stop": "node dev-multi.mjs stop",
        "dev:multi:status": "node dev-multi.mjs status",
        "build": "pnpm build:im-engine && next build",
        "build:im-engine": "node scripts/build-im-engine.mjs",
        "test:recording": "node tests/contracts/room-recording.mjs",
        "test:resilience": "node tests/contracts/meeting-resilience.mjs",
        "test:audio": "node tests/contracts/meeting-audio.mjs",
        "test:camera": "node tests/contracts/camera-preview.mjs",
        "test:meeting-chat": "node tests/contracts/meeting-im-chat.mjs",
        "test:meeting-entry": "node tests/contracts/meeting-entry-ui.mjs",
        "test:notifications": "node tests/contracts/meeting-notifications.mjs",
        "test:screen": "node tests/contracts/im-rtc-screen.mjs",
        "test:unit": "node scripts/test-unit.mjs",
        "test:updater-init": "node --test tests/scripts/init-updater.test.mjs",
        "test:build-logs": "node --test tests/scripts/build-credential-logs.test.mjs",
        "test:ci": "pnpm exec tsc --noEmit && pnpm test:unit && pnpm test:recording && pnpm test:resilience && pnpm test:audio && pnpm test:camera && pnpm test:screen && pnpm test:meeting-chat && pnpm test:meeting-entry && pnpm test:notifications && pnpm test:updater-init && pnpm test:build-config",
        "test:e2e:native": "node ../tests/e2e/native-meeting.mjs",
        "test:e2e:screen-layout": "node ../tests/e2e/screen-share-layout.mjs",
        "test:e2e:upcoming": "node ../tests/e2e/upcoming-meetings.mjs",
        "export": "next export",
        "start": "next start -p 3118",
        "tauri": "tauri",
        "updater:init": "node scripts/init-updater.mjs",
        "tauri:dev": "tauri dev",
        "tauri:build": "tauri build",
        "tauri:build:dev": "node --env-file=.env.build.dev --env-file=src-tauri/signing/updater/dev/password.env node_modules/@tauri-apps/cli/tauri.js build --config src-tauri/signing/updater/dev/tauri.updater.json",
        "tauri:build:test": "node --env-file=.env.build.test --env-file=src-tauri/signing/updater/test/password.env node_modules/@tauri-apps/cli/tauri.js build --config src-tauri/signing/updater/test/tauri.updater.json",
        "tauri:build:prod": "node --env-file=.env.build.prod --env-file=src-tauri/signing/updater/prod/password.env node_modules/@tauri-apps/cli/tauri.js build --config src-tauri/signing/updater/prod/tauri.updater.json",
        "lint": "next lint",
        "test:build-config": "node --test tests/scripts/prepare-ci-build.test.mjs"
    },
    "dependencies": {
        "@blocknote/core": "0.36.0",
        "@blocknote/react": "0.36.0",
        "@blocknote/shadcn": "0.36.0",
        "@deeprespond/im-tauri": "1.0.0-alpha",
        "@deeprespond/im-web": "1.0.0-alpha",
        "@deeprespond/im-web-react": "1.0.0-alpha",
        "@heroicons/react": "^2.2.0",
        "@hookform/resolvers": "^5.1.1",
        "@radix-ui/react-accordion": "^1.2.12",
        "@radix-ui/react-dialog": "^1.1.14",
        "@radix-ui/react-dropdown-menu": "^2.1.16",
        "@radix-ui/react-label": "^2.1.7",
        "@radix-ui/react-popover": "^1.1.15",
        "@radix-ui/react-progress": "^1.1.8",
        "@radix-ui/react-scroll-area": "^1.2.9",
        "@radix-ui/react-select": "^2.2.5",
        "@radix-ui/react-separator": "^1.1.7",
        "@radix-ui/react-slot": "^1.2.3",
        "@radix-ui/react-switch": "^1.2.5",
        "@radix-ui/react-tabs": "^1.1.12",
        "@radix-ui/react-tooltip": "^1.2.8",
        "@remirror/core": "^3.0.1",
        "@remirror/extension-bold": "^3.0.1",
        "@remirror/extension-italic": "^3.0.1",
        "@remirror/extension-list": "^3.0.1",
        "@remirror/extension-markdown": "^3.0.1",
        "@remirror/extension-mention": "^3.0.1",
        "@remirror/extension-underline": "^3.0.1",
        "@remirror/pm": "^3.0.0",
        "@remirror/react": "^3.0.1",
        "@tanstack/react-virtual": "^3.13.13",
        "@tauri-apps/api": "^2.12.4",
        "@tauri-apps/plugin-fs": "^2.7.1",
        "@tauri-apps/plugin-notification": "^2.7.0",
        "@tauri-apps/plugin-os": "^2.4.0",
        "@tauri-apps/plugin-process": "^2.4.0",
        "@tauri-apps/plugin-store": "^2.5.0",
        "@tiptap/pm": "^2.10.4",
        "@tiptap/react": "^2.10.4",
        "@tiptap/starter-kit": "^2.10.4",
        "@types/lodash": "^4.17.13",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "cmdk": "^1.1.1",
        "date-fns": "^4.1.0",
        "dompurify": "^3.1.7",
        "framer-motion": "^11.15.0",
        "lodash": "^4.17.21",
        "lucide-react": "^0.469.0",
        "marked": "^14.1.3",
        "next": "^14.2.25",
        "radix-ui": "^1.4.3",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "react-hook-form": "^7.59.0",
        "react-markdown": "^9.0.1",
        "remark-gfm": "^4.0.1",
        "sonner": "^2.0.7",
        "tailwind-merge": "^3.3.1",
        "tailwindcss-animate": "^1.0.7",
        "zod": "^3.25.71"
    },
    "devDependencies": {
        "@tailwindcss/container-queries": "^0.1.1",
        "@tailwindcss/typography": "^0.5.15",
        "@tauri-apps/cli": "^2.12.0",
        "@tauri-apps/plugin-fs": "^2.7.1",
        "@types/bun": "1.3.14",
        "@types/jsdom": "^30.0.0",
        "@types/node": "^20",
        "@types/react": "^18.3.18",
        "@types/react-dom": "^18.3.5",
        "@types/react-test-renderer": "18.3.1",
        "autoprefixer": "^10.0.1",
        "concurrently": "^8.2.2",
        "esbuild": "^0.25.0",
        "jsdom": "^30.1.2",
        "playwright": "1.64.1",
        "postcss": "^8",
        "react-test-renderer": "18.3.1",
        "tailwindcss": "^3.4.1",
        "typescript": "^5.7.2",
        "wait-on": "^7.2.0"
    },
    "packageManager": "pnpm@12.14.0"
}

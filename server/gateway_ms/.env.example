# gateway_ms（统一入口网关，端口 39110）
# ---- 必填（生产） ----
OPENMEETING_ADMIN_PASSWORD=change-me
# 管理端 JWT 验签密钥（必须与 user_ms 完全一致）
OPENMEETING_SECRET_KEY=
# ---- 路由与认证 ----
# OPENMEETING_DATABASE_URL=postgresql+asyncpg://openmeeting:openmeeting@localhost:5432/openmeeting_user  # 会话库（只读+滑动续期）
# OPENMEETING_USER_MS_URL=http://user_ms:39113
# OPENMEETING_MEETING_MS_URL=http://meeting_ms:39107
# OPENMEETING_STT_MS_URL=http://stt_ms:39109
OPENMEETING_INTERNAL_SERVICE_TOKEN=
# 裸机启动时显式启用；Compose 已启用，39111 不发布宿主端口。
OPENMEETING_EGRESS_ENABLED=true
OPENMEETING_EGRESS_HOST=0.0.0.0
OPENMEETING_EGRESS_PORT=39111
OPENMEETING_EGRESS_ALLOWED_HOSTS='[]'
OPENMEETING_EGRESS_ALLOWED_PORTS='[80,443]'
OPENMEETING_EGRESS_PRIVATE_HOSTS='[]'
# OPENMEETING_EGRESS_CONNECT_TIMEOUT=10
# OPENMEETING_EGRESS_IDLE_TIMEOUT=600
# OPENMEETING_EGRESS_MAX_CONNECTIONS=256
# OPENMEETING_SESSION_CACHE_TTL_SEC=30     # 会话认证缓存秒数（吊销/禁用最迟此时生效）
# OPENMEETING_TRUSTED_PROXIES=            # 网关之前的反向代理网段（可信 X-Forwarded-For）
# OPENMEETING_LOG_LEVEL=INFO
# OPENMEETING_CORS_ORIGINS=

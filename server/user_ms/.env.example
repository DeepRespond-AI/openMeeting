# user_ms（用户域服务，端口 39113）
# 数据库（docker-compose 会自动拼出地址，仅裸机部署需要设置）
# OPENMEETING_DATABASE_URL=postgresql+asyncpg://openmeeting:openmeeting@localhost:5432/openmeeting_user
OPENMEETING_DATA_DIR=./data
# ---- 必填（生产） ----
# 管理端登录密码（未设置时服务拒绝启动；仅 OPENMEETING_ENV=dev 时默认 admin）
OPENMEETING_ADMIN_PASSWORD=change-me
# 用于签发管理端会话 JWT、加密短信 AccessKey Secret 及验证码摘要的盐。
# 与其他 ms 共用同一值以保持数据可迁移；留空则自动生成并保存到 $OPENMEETING_DATA_DIR/secret_key。
OPENMEETING_SECRET_KEY=
# ---- 运行参数 ----
# OPENMEETING_LOG_LEVEL=INFO
# OPENMEETING_CORS_ORIGINS=
# OPENMEETING_TRUSTED_PROXIES=        # 网关之前若还有反向代理，填其 IP/网段；仅经网关时留空
# 内部服务令牌（必须与网关一致；留空时本服务接受未认证请求，仅限本地开发）
OPENMEETING_INTERNAL_SERVICE_TOKEN=
# 协作服务地址
OPENMEETING_GATEWAY_MS_URL=http://localhost:39110
# IM / OSS / 短信出站代理；内部令牌必须与 gateway 一致。
OPENMEETING_EGRESS_PROXY_URL=http://localhost:39111
# ---- 阿里云短信（手机号注册/登录验证码；覆盖管理端保存的配置） ----
# OPENMEETING_SMS_ACCESS_KEY_ID=
# OPENMEETING_SMS_ACCESS_KEY_SECRET=
# OPENMEETING_SMS_SIGN_NAME=
# OPENMEETING_SMS_TEMPLATE_CODE=
# OPENMEETING_SMS_TEMPLATE_PARAM=code
# OPENMEETING_SMS_ENDPOINT=dysmsapi.aliyuncs.com

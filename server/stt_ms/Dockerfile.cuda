# stt_ms — NVIDIA GPU image (CUDA 12 + cuDNN 9: faster-whisper float16, FunASR on cuda:0)
# Build context: server/   Run with: docker compose -f docker-compose.yml -f docker-compose.gpu.yml up -d --build
FROM nvidia/cuda:12.4.1-cudnn-runtime-ubuntu22.04
ENV DEBIAN_FRONTEND=noninteractive PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
    UV_PYTHON_INSTALL_DIR=/opt/python \
    OPENMEETING_DATA_DIR=/data \
    MODELSCOPE_CACHE=/data/models/.modelscope
RUN apt-get update \
 && apt-get install -y --no-install-recommends ffmpeg libsndfile1 curl ca-certificates \
 && rm -rf /var/lib/apt/lists/*
COPY --from=ghcr.io/astral-sh/uv:0.13.3 /uv /usr/local/bin/uv

WORKDIR /srv
COPY pyproject.toml uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv python install 3.11.17 \
 && UV_PROJECT_ENVIRONMENT=/opt/venv UV_LINK_MODE=copy \
    uv sync --locked --python 3.11.17 --no-dev --no-install-project --extra stt-cuda
ENV VIRTUAL_ENV=/opt/venv PATH=/opt/venv/bin:$PATH

COPY stt_ms/alembic.ini ./stt_ms/alembic.ini
COPY stt_ms/migrations ./stt_ms/migrations
COPY stt_ms ./stt_ms
COPY service_net ./service_net

VOLUME ["/data"]
EXPOSE 39109
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s CMD curl -fsS http://localhost:39109/healthz || exit 1
CMD ["python", "-m", "uvicorn", "stt_ms.main:app", "--host", "0.0.0.0", "--port", "39109"]

# stt_ms（语音识别推理服务，端口 39109）
# 数据库（docker-compose 会自动拼出地址，仅裸机部署需要设置）
# OPENMEETING_DATABASE_URL=postgresql+asyncpg://openmeeting:openmeeting@localhost:5432/openmeeting_stt
OPENMEETING_DATA_DIR=./data
# OPENMEETING_STT_CONCURRENCY=1        # 同时进行的语音识别推理数（GPU 显存充足可调大）
# OPENMEETING_LOG_LEVEL=INFO
# OPENMEETING_CORS_ORIGINS=
# 模型加密密钥（加密云端识别 API Key；与其他 ms 共用同一值以保持数据可迁移）
OPENMEETING_SECRET_KEY=
# 内部服务令牌（必须与网关一致；留空时本服务接受未认证请求，仅限本地开发）
OPENMEETING_INTERNAL_SERVICE_TOKEN=
# 云 ASR / WSS / 模型下载代理；生产禁止置空直连。
OPENMEETING_EGRESS_PROXY_URL=http://localhost:39111
# ---- 模型下载镜像（可选） ----
# HF_ENDPOINT=https://hf-mirror.com
